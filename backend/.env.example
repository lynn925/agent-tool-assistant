# OpenAI (M2 起必填)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=

# DeepSeek —— 可选的第二个 provider（M6 起）。
# 去 https://platform.deepseek.com/api_keys 申请 key，填到这里就能在前端切过去。
# 留空 = 不启用，前端会把这个 provider 置灰。
#
# ⚠️ 填完 key 后要重启后端 —— 配置是在启动时读的。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# DeepSeek 的默认模型（前端切到 DeepSeek 时默认用它）
DEEPSEEK_MODEL=deepseek-v4-pro

# SerpAPI (M2 搜索工具用，去 https://serpapi.com/ 注册)
SERPAPI_API_KEY=

# CORS：允许的前端 origin
FRONTEND_ORIGIN=http://localhost:3000

# M5 错误恢复：最大重试次数（不含首次尝试）。
# 3 = 最多尝试 4 次，退避 1s/2s/4s
RETRY_MAX_ATTEMPTS=3
